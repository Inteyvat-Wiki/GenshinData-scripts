{
  "name": "genshindata-scripts",
  "description": "Node scripts to extract data from ExcelBinOutput",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "types": "index.d.ts",
  "engines": { "node": ">=22.13" },
  "files": ["index.js", "index.d.ts", "runtime-config.js", "main.js", "archives.js", "misc.js", "subtitles.js", "cache/", "extract/", "versions/", "resources/*.js", "!resources/*.test.js", "LICENSE", "LICENSES/", "NOTICES.md", "docs/", "README.md"],
  "scripts": {
    "test:unit": "node scripts/test-unit.cjs",
    "cache": "node cache/cli.js",
    "cache:prepare": "node cache/cli.js prepare",
    "cache:inspect": "node cache/cli.js inspect",
    "cache:verify": "node cache/cli.js verify",
    "test:cache": "node --test cache/*.test.js",
    "start": "node main.js",
    "export:misc": "node misc.js",
    "test:misc": "node --test extract/misc/*.test.js",
    "test:cosmetics": "node --test extract/cosmetics.test.js cache/cosmetics.test.js",
    "test:maps": "node --test extract/maps/*.test.js resources/maps.test.js resources/map-icons.test.js resources/world-areas.test.js",
    "export:archives": "node archives.js",
    "export:subtitles": "node subtitles.js",
    "test:subtitles": "node extract/subtitles/check_narration.js && node extract/subtitles/check_bubbles.js",
    "test:archives": "node --test extract/archives/*.test.js && node extract/archives/check_serenitea.js && node extract/archives/check_tcg.js && node extract/archives/check_miliastra.js && node extract/archives/check_dialogues.js",
    "buildversions": "node versions/textmap.js",
    "exportversions": "node main.js --versions-only",
    "test:versions": "node --test versions/*.test.js",
    "buildstats": "node stats/copyStatsData.js && npx webpack --config stats/webpack.all.config.js && npx webpack --config stats/webpack.characters.config.js && npx webpack --config stats/webpack.weapons.config.js",
    "audio": "cd voice && node audio.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Inteyvat-Wiki/GenshinData-scripts.git"
  },
  "author": "Inteyvat-Wiki",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@inteyvat-wiki/resource-tools": "file:../Inteyvat-Wiki-resource-tools",
    "fuzzysort": "^2.0.1"
  },
  "devDependencies": {
    "fnv-plus": "^1.3.1",
    "webpack": "^5.9.0",
    "webpack-cli": "^4.2.0"
  },
  "bugs": {
    "url": "https://github.com/Inteyvat-Wiki/GenshinData-scripts/issues"
  },
  "homepage": "https://github.com/Inteyvat-Wiki/GenshinData-scripts#readme"
}
