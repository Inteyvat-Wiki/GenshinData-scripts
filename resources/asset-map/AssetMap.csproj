<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings>
    <Studio Condition="'$(Studio)' == ''">C:/Apps/AnimeStudio</Studio>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AnimeStudio"><HintPath>$(Studio)/bin/AnimeStudio.dll</HintPath></Reference>
    <Reference Include="AnimeStudio.PInvoke"><HintPath>$(Studio)/bin/AnimeStudio.PInvoke.dll</HintPath></Reference>
    <Reference Include="MessagePack"><HintPath>$(Studio)/bin/MessagePack.dll</HintPath></Reference>
    <Reference Include="MessagePack.Annotations"><HintPath>$(Studio)/bin/MessagePack.Annotations.dll</HintPath></Reference>
    <Reference Include="ZstdSharp"><HintPath>$(Studio)/bin/ZstdSharp.dll</HintPath></Reference>
  </ItemGroup>
</Project>
